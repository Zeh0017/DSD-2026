/**
 * S2 Data Acquisition Service
 * Core S2 module: reads from S1, validates, processes, delivers to M1 and V2.
 *
 * Implements:
 *   IF-M1-S2 (Section 3.3): s2.session.start(), s2.session.stop()
 *   IF-S2-M1 (Section 3.4): s2.data.read()
 *
 * SRS Use Cases implemented:
 *   IUC-S2-01-01: Start Session's Data Processing Work
 *   IUC-S2-01-02: End Session's Data Processing Work
 *   IUC-S2-02-01: Deliver Formal Sensor Data
 *   IUC-S2-03-01: Start Session's Raw Data Collecting Work
 *   IUC-S2-03-02: End Session's Raw Data Collecting Work
 *   IUC-S2-03-03: Deliver Raw Sensor Data
 */
import { Logger } from '../service/FileLoggerService';
import { S1SensorAdapter } from './S1SensorAdapter';
import { S2V2HttpClient } from './S2V2HttpClient';
import {
  SensorSample,
  FormatData,
  SessionContext,
  TargetAngle,
  ErrorEvent,
  StartResult,
  SessionSummary
} from './S2DataModels';

const TAG = 'S2DataAcquisition';

const ACQUISITION_INTERVAL_MS = 33;   // ~30Hz data acquisition from S1
const UPLOAD_INTERVAL_MS = 1000;      // Upload to V2 every 1 second
const S1_READ_TIMEOUT_MS = 2000;      // SRS IUC-S2-03-03 Alt 4: S1 read timeout

export class S2DataAcquisitionService {
  private static instance: S2DataAcquisitionService | null = null;

  private s1Adapter: S1SensorAdapter;
  private v2Client: S2V2HttpClient;

  private sessionActive: boolean = false;
  private sessionContext: SessionContext = new SessionContext();
  private sessionStartTime: number = 0;
  private totalSampleCount: number = 0;
  private totalErrorCount: number = 0;

  // Double buffering: M1 delivery buffer and V2 upload buffer
  private m1SensorBuffer: SensorSample[] = [];
  private m1TargetAngleBuffer: TargetAngle[] = [];
  private m1ErrorBuffer: ErrorEvent[] = [];

  // Periodic logging counter (avoid flooding logs at 30Hz)
  private acquireCallCount: number = 0;
  private readCallCount: number = 0;

  private v2SensorBuffer: SensorSample[] = [];
  private v2TargetAngleBuffer: TargetAngle[] = [];
  private v2ErrorBuffer: ErrorEvent[] = [];

  // V2 confirmation monitor state (SRS IUC-S2-02-01 step 4)
  // Errors from V2 upload are stored here and drained into FormatData.errors
  // on the next read() call — implements "returns error on next call" per SRS Alt 7/9.
  private v2PendingErrors: ErrorEvent[] = [];
  private v2ConfirmationMonitorStarted: boolean = false;

  private acquisitionTimer: number | null = null;
  private uploadTimer: number | null = null;

  // Track last timestamp for monotonicity validation
  private lastTimestamp: number = 0;

  // Track last time S1 returned non-empty data (SRS IUC-S2-03-03 Alt 4)
  private lastS1DataTime: number = 0;
  private s1TimeoutReported: boolean = false;

  private constructor() {
    this.s1Adapter = S1SensorAdapter.getInstance();
    this.v2Client = S2V2HttpClient.getInstance();
  }

  static getInstance(): S2DataAcquisitionService {
    if (!S2DataAcquisitionService.instance) {
      S2DataAcquisitionService.instance = new S2DataAcquisitionService();
    }
    return S2DataAcquisitionService.instance;
  }

  /**
   * Start a data acquisition session.
   * (IF-M1-S2, Section 3.3.1 — s2.session.start)
   * (SRS IUC-S2-01-01: Start Session's Data Processing Work)
   *
   * Step 1: M1 calls this method, passing user Token and session meta data.
   * Step 2: S2 initializes (validates params, starts S1, starts V2 upload loop).
   * Step 3: Returns confirmation (StartResult).
   *
   * @param sessionId Session identifier, server-generated by V2. MUST be > 0.
   * @param userId User identifier, referencing V2 users table. MUST be > 0.
   * @param sensorJointMapping Mapping from sensor device ID to joint name. Optional.
   * @param payloadStatus Exercise/task type. MUST be non-empty.
   * @param token User auth token for V2 communication (SRS IUC-S2-01-01 step 1).
   * @returns StartResult
   * @throws Error if required parameters are invalid (Section 3.3.1: ValueError)
   */
  start(
    sessionId: number,
    userId: number,
    sensorJointMapping: Record<string, string> | undefined,
    payloadStatus: string,
    token: string
  ): StartResult {
    Logger.debug(TAG, `start() called: sessionId=${sessionId}, userId=${userId}, payloadStatus=${payloadStatus}, hasMapping=${sensorJointMapping !== undefined}, hasToken=${token.length > 0}`);
    const result = new StartResult();

    // Parameter validation (Section 3.3.1: Raises ValueError if required parameters are invalid)
    if (sessionId <= 0) {
      throw new Error('ValueError: sessionId must be a positive integer');
    }
    if (userId <= 0) {
      throw new Error('ValueError: userId must be a positive integer');
    }
    if (!payloadStatus || payloadStatus.length === 0) {
      throw new Error('ValueError: payloadStatus must be non-empty');
    }

    // Check if session already active (Section 3.3.3: "session_already_active")
    if (this.sessionActive) {
      result.success = false;
      result.errorMessage = 'session_already_active';
      Logger.warn(TAG, 'Cannot start: session already active');
      return result;
    }

    // Check sensor status via S1 (Section 3.3.3: "sensor_not_connected")
    const sensorStatus = this.s1Adapter.status();
    Logger.debug(TAG, `S1 sensor status: connected=${sensorStatus.connected}, error=${sensorStatus.errorMessage}`);
    if (!sensorStatus.connected) {
      result.success = false;
      result.errorMessage = 'sensor_not_connected';
      Logger.warn(TAG, 'Cannot start: sensor not connected');
      return result;
    }

    // Initialize session context
    this.sessionContext = new SessionContext();
    this.sessionContext.sessionId = sessionId;
    this.sessionContext.userId = userId;
    this.sessionContext.sensorJointMapping = sensorJointMapping ?? {};
    this.sessionContext.payloadStatus = payloadStatus;
    this.sessionContext.token = token;

    this.sessionStartTime = Date.now();
    this.totalSampleCount = 0;
    this.totalErrorCount = 0;
    this.lastTimestamp = 0;
    this.lastS1DataTime = Date.now();
    this.s1TimeoutReported = false;
    this.acquireCallCount = 0;
    this.readCallCount = 0;
    this.clearBuffers();

    // SRS IUC-S2-03-01: Start Session's Raw Data Collecting Work
    // S2 calls S1's session start method, passing session meta data.
    // S1 initializes and returns confirmation signal.
    Logger.debug(TAG, 'Calling S1.startSession()');
    const s1Started = this.s1Adapter.startSession(this.sessionContext);
    Logger.debug(TAG, `S1.startSession() returned: ${s1Started}`);
    if (!s1Started) {
      // SRS IUC-S2-03-01 Alt 2: Initialization fails → S2 terminates and returns error
      result.success = false;
      result.errorMessage = 'sensor_not_connected';
      Logger.error(TAG, 'S1 session start failed');
      return result;
    }

    // Start acquisition loop: periodically read from S1, validate, buffer
    // (SRS IUC-S2-03-03: Deliver Raw Sensor Data — periodically called by S2)
    this.acquisitionTimer = setInterval(() => {
      this.acquireAndProcess();
    }, ACQUISITION_INTERVAL_MS);

    // SRS IUC-S2-02-01 step 4: Start subprocess to receive V2 confirmation
    // (only one needs to be started per session).
    // Implemented as the async upload loop with error tracking.
    this.startV2ConfirmationMonitor();

    this.sessionActive = true;
    result.success = true;
    Logger.info(TAG, `Session started: id=${sessionId}, userId=${userId}, exercise=${payloadStatus}`);

    return result;
  }

  /**
   * Stop the current session.
   * (IF-M1-S2, Section 3.3.2 — s2.session.stop)
   * (SRS IUC-S2-01-02: End Session's Data Processing Work)
   *
   * S2 flushes remaining buffered data to V2, then enters idle state.
   *
   * @returns SessionSummary
   * @throws Error if no session is active (Section 3.3.2: RuntimeError)
   */
  async stop(): Promise<SessionSummary> {
    Logger.debug(TAG, `stop() called: sessionActive=${this.sessionActive}`);
    // Section 3.3.2: Raises RuntimeError if no session is active
    if (!this.sessionActive) {
      throw new Error('RuntimeError: No active session to stop');
    }

    // Stop acquisition loop
    if (this.acquisitionTimer !== null) {
      clearInterval(this.acquisitionTimer);
      this.acquisitionTimer = null;
    }

    // Stop V2 confirmation monitor (upload loop)
    this.stopV2ConfirmationMonitor();

    // SRS IUC-S2-03-02: End Session's Raw Data Collecting Work
    // S2 calls S1's session end method. S1 finalizes and returns confirmation.
    Logger.debug(TAG, 'Calling S1.stopSession()');
    const s1Stopped = this.s1Adapter.stopSession();
    Logger.debug(TAG, `S1.stopSession() returned: ${s1Stopped}`);
    if (!s1Stopped) {
      // SRS IUC-S2-03-02 Alt 2: Finalization fails → S2 terminates and returns error
      Logger.error(TAG, 'S1 session stop failed');
    }

    Logger.debug(TAG, 'Flushing remaining V2 buffer');
    // Flush remaining data to V2 (Section 3.3.2: "flushes remaining buffered data to V2")
    await this.uploadToV2();

    // End session on V2
    try {
      await this.v2Client.endSession(this.sessionContext.sessionId, this.sessionContext.token);
    } catch (error) {
      Logger.error(TAG, `Failed to end session on V2: ${String(error)}`);
    }

    // Build SessionSummary (Section 3.3.4)
    const summary = new SessionSummary();
    summary.sessionId = this.sessionContext.sessionId;
    summary.sampleCount = this.totalSampleCount;
    summary.errorCount = this.totalErrorCount;
    summary.startTime = new Date(this.sessionStartTime).toISOString();
    summary.endTime = new Date(Date.now()).toISOString();

    this.sessionActive = false;
    this.clearBuffers();

    Logger.info(TAG, `Session stopped: samples=${summary.sampleCount}, errors=${summary.errorCount}`);

    return summary;
  }

  /**
   * Read all FormatData accumulated since the last call.
   * (IF-S2-M1, Section 3.4.1 — s2.data.read)
   * (SRS IUC-S2-02-01: Deliver Formal Sensor Data)
   *
   * Step 2: Packages data accumulated since last delivery.
   * Step 5: Returns the FormatData to M1.
   *
   * Also drains V2 pending errors (SRS IUC-S2-02-01 Alt 7/9):
   * "The main method returns the error on the next call of this use case by M1."
   *
   * @returns FormatData with three asynchronous lists + session context
   */
  read(): FormatData {
    const data = new FormatData();
    data.sessionContext = this.sessionContext;

    // Drain M1 delivery buffers
    data.sensorData = this.m1SensorBuffer;
    data.targetAngles = this.m1TargetAngleBuffer;
    data.errors = this.m1ErrorBuffer;

    // SRS IUC-S2-02-01 Alt 7/9: Merge V2 pending errors into this delivery.
    // "The main method returns the error on the next call of this use case by M1."
    if (this.v2PendingErrors.length > 0) {
      for (const err of this.v2PendingErrors) {
        data.errors.push(err);
      }
      this.v2PendingErrors = [];
    }

    // Clear M1 buffers
    this.m1SensorBuffer = [];
    this.m1TargetAngleBuffer = [];
    this.m1ErrorBuffer = [];

    // Periodic log for read() calls — every ~5 seconds (150 reads at 30fps)
    this.readCallCount++;
    if (this.readCallCount % 150 === 0) {
      Logger.info(TAG, `M1 read #${this.readCallCount}: delivered ${data.sensorData.length}s/${data.targetAngles.length}a/${data.errors.length}e`);
    }

    return data;
  }

  /**
   * Check if a session is currently active.
   */
  isActive(): boolean {
    return this.sessionActive;
  }

  // ========================================================================
  // V2 Confirmation Monitor (SRS IUC-S2-02-01 step 4)
  // "Starts a subprocess to receive V2's confirmation
  //  (only one needs to be started per session)"
  //
  // Implemented as a periodic upload loop. Each upload awaits V2 response.
  // On success: confirmation received, subprocess continues (step 9).
  // On failure: error is stored in v2PendingErrors for next read() (Alt 3/7/9).
  // ========================================================================

  /**
   * Start the V2 confirmation monitor (upload loop).
   * Called once per session at start() time.
   */
  private startV2ConfirmationMonitor(): void {
    if (this.v2ConfirmationMonitorStarted) {
      return;
    }
    this.v2PendingErrors = [];

    this.uploadTimer = setInterval(() => {
      this.uploadToV2();
    }, UPLOAD_INTERVAL_MS);

    this.v2ConfirmationMonitorStarted = true;
    Logger.info(TAG, 'V2 confirmation monitor started');
  }

  /**
   * Stop the V2 confirmation monitor.
   */
  private stopV2ConfirmationMonitor(): void {
    if (this.uploadTimer !== null) {
      clearInterval(this.uploadTimer);
      this.uploadTimer = null;
    }
    this.v2ConfirmationMonitorStarted = false;
    Logger.info(TAG, 'V2 confirmation monitor stopped');
  }

  // ========================================================================
  // Data Acquisition Loop
  // (SRS IUC-S2-03-03: Deliver Raw Sensor Data — periodically called by S2)
  // ========================================================================

  /**
   * Internal: Read from S1, validate, compute target angles, buffer data.
   * Called at ~30Hz by the acquisition timer.
   *
   * SRS IUC-S2-03-03 basic flow:
   *   Step 1: S2 calls S1's deliver raw sensor data method (s1.read()).
   *   Step 2: S1 packages accumulated data.
   *   Step 3: S1 returns raw sensor data.
   *   Step 4: S2 receives data; continues.
   *
   * SRS IUC-S2-03-03 Alt 4:
   *   S1 method does not finish normally / times out → S2 returns error.
   */
  private acquireAndProcess(): void {
    if (!this.sessionActive) {
      return;
    }

    this.acquireCallCount++;

    // Check sensor status
    const status = this.s1Adapter.status();
    if (!status.connected) {
      const errorEvent = new ErrorEvent();
      errorEvent.timestamp = Date.now();
      errorEvent.sensorId = null;
      errorEvent.errorType = 'sensor_disconnected';
      errorEvent.message = 'Sensor connection lost during acquisition';
      this.m1ErrorBuffer.push(errorEvent);
      this.v2ErrorBuffer.push(errorEvent);
      this.totalErrorCount++;
      return;
    }

    // SRS IUC-S2-03-03 step 1: S2 calls S1's deliver raw sensor data method
    const rawSamples = this.s1Adapter.read();

    // SRS IUC-S2-03-03 Alt 4: S1 read timeout detection
    // If S1 returns empty data for too long while still connected, report timeout.
    if (rawSamples.length === 0) {
      const timeSinceLastData = Date.now() - this.lastS1DataTime;
      if (timeSinceLastData > S1_READ_TIMEOUT_MS && !this.s1TimeoutReported) {
        const errorEvent = new ErrorEvent();
        errorEvent.timestamp = Date.now();
        errorEvent.sensorId = null;
        errorEvent.errorType = 'timeout';
        errorEvent.message = `S1 read timeout: no data for ${timeSinceLastData}ms`;
        this.m1ErrorBuffer.push(errorEvent);
        this.v2ErrorBuffer.push(errorEvent);
        this.totalErrorCount++;
        this.s1TimeoutReported = true;
      }
      return;
    }

    // Data received — reset timeout tracking
    this.lastS1DataTime = Date.now();
    this.s1TimeoutReported = false;

    const validSamples: SensorSample[] = [];

    for (const sample of rawSamples) {
      // Validate sample
      if (!this.validateSample(sample)) {
        const errorEvent = new ErrorEvent();
        errorEvent.timestamp = Date.now();
        errorEvent.sensorId = sample.deviceId;
        errorEvent.errorType = 'validation_failure';
        errorEvent.message = `Invalid sample from ${sample.deviceId}: NaN or out-of-range values`;
        this.m1ErrorBuffer.push(errorEvent);
        this.v2ErrorBuffer.push(errorEvent);
        this.totalErrorCount++;
        continue;
      }

      validSamples.push(sample);
      this.totalSampleCount++;
      this.lastTimestamp = sample.timestamp;
    }

    // Add to M1 and V2 buffers
    for (const s of validSamples) {
      this.m1SensorBuffer.push(s);
      this.v2SensorBuffer.push(s);
    }

    // Compute target angles from validated samples using sensorJointMapping
    const targetAngles = this.computeTargetAngles(validSamples);
    for (const ta of targetAngles) {
      this.m1TargetAngleBuffer.push(ta);
      this.v2TargetAngleBuffer.push(ta);
    }

    // Periodic status log every ~5 seconds (150 calls at 30Hz)
    if (this.acquireCallCount % 150 === 0) {
      Logger.info(TAG, `Acquisition status: totalSamples=${this.totalSampleCount}, totalErrors=${this.totalErrorCount}, m1Buffer=${this.m1SensorBuffer.length}s/${this.m1TargetAngleBuffer.length}a, v2Buffer=${this.v2SensorBuffer.length}s/${this.v2TargetAngleBuffer.length}a`);
    }
  }

  /**
   * Validate a single sensor sample.
   */
  private validateSample(sample: SensorSample): boolean {
    // Check for NaN
    if (isNaN(sample.roll) || isNaN(sample.pitch) || isNaN(sample.yaw)) {
      return false;
    }
    if (isNaN(sample.accX) || isNaN(sample.accY) || isNaN(sample.accZ)) {
      return false;
    }
    if (isNaN(sample.gyroX) || isNaN(sample.gyroY) || isNaN(sample.gyroZ)) {
      return false;
    }

    // Check reasonable range for orientation angles (-360 to 360)
    if (Math.abs(sample.roll) > 360 || Math.abs(sample.pitch) > 360 || Math.abs(sample.yaw) > 360) {
      return false;
    }

    // Check timestamp monotonicity
    if (sample.timestamp < this.lastTimestamp) {
      return false;
    }

    return true;
  }

  /**
   * Compute target angles from sensor samples using the sensorJointMapping.
   * Maps sensor orientation (roll) to the joint angle identified by the mapping.
   */
  private computeTargetAngles(samples: SensorSample[]): TargetAngle[] {
    const angles: TargetAngle[] = [];
    const mapping = this.sessionContext.sensorJointMapping;

    for (const sample of samples) {
      const jointName = mapping[sample.deviceId];
      if (jointName) {
        // Map sensor roll to the joint angle
        const ta = new TargetAngle();
        ta.timestamp = sample.timestamp;
        ta.angleID = jointName;
        ta.angle = Math.round(sample.roll * 100) / 100;
        angles.push(ta);
      } else if (Object.keys(mapping).length === 0) {
        // No mapping provided: use default mapping based on roll angle
        const ta = new TargetAngle();
        ta.timestamp = sample.timestamp;
        ta.angleID = 'knee'; // Default to knee for single-sensor setup
        ta.angle = Math.round(sample.roll * 100) / 100;
        angles.push(ta);
      }
    }

    return angles;
  }

  // ========================================================================
  // V2 Upload with Error Propagation
  // (SRS IUC-S2-02-01 steps 3, 7-9 and alternatives)
  // ========================================================================

  /**
   * Upload buffered data to V2 asynchronously.
   * Part of the V2 confirmation monitor subprocess.
   *
   * SRS IUC-S2-02-01 step 3: Transmits FormatData over network with Token + meta data.
   * SRS IUC-S2-02-01 step 9: Receives confirmation signal; subprocess continues.
   *
   * Error propagation (stored in v2PendingErrors, drained on next read()):
   *   - Alt 3: Network transmission fails → error stored
   *   - Alt 7: V2 verification fails → error stored
   *   - Alt 9: V2 does not respond (timeout) → error stored
   */
  private async uploadToV2(): Promise<void> {
    if (this.v2SensorBuffer.length === 0 &&
        this.v2TargetAngleBuffer.length === 0 &&
        this.v2ErrorBuffer.length === 0) {
      return;
    }

    const sensorCount = this.v2SensorBuffer.length;
    const angleCount = this.v2TargetAngleBuffer.length;
    const errorCount = this.v2ErrorBuffer.length;
    Logger.info(TAG, `Uploading to V2: ${sensorCount} sensors, ${angleCount} angles, ${errorCount} errors`);

    // Drain V2 buffers into a FormatData for upload
    const data = new FormatData();
    data.sessionContext = this.sessionContext;
    data.sensorData = this.v2SensorBuffer;
    data.targetAngles = this.v2TargetAngleBuffer;
    data.errors = this.v2ErrorBuffer;

    this.v2SensorBuffer = [];
    this.v2TargetAngleBuffer = [];
    this.v2ErrorBuffer = [];

    try {
      // SRS IUC-S2-02-01 step 3: transmit with Token
      await this.v2Client.uploadMeasurements(
        this.sessionContext.sessionId,
        data,
        this.sessionContext.token
      );
      // SRS IUC-S2-02-01 step 9: V2 confirmation received; subprocess continues.
      Logger.info(TAG, `V2 upload confirmed: ${sensorCount} sensors, ${angleCount} angles`);
    } catch (error) {
      // SRS IUC-S2-02-01 Alt 3: Network transmission fails.
      // SRS IUC-S2-02-01 Alt 7: V2 verification fails (non-success HTTP status).
      // SRS IUC-S2-02-01 Alt 9: V2 does not respond for extended period (timeout).
      // → Store error for propagation to M1 on next read() call.
      const errorEvent = new ErrorEvent();
      errorEvent.timestamp = Date.now();
      errorEvent.sensorId = null;
      errorEvent.errorType = 'timeout'; // Generic: covers network fail, rejection, timeout
      errorEvent.message = `V2 upload failed: ${String(error)}`;
      this.v2PendingErrors.push(errorEvent);
      this.totalErrorCount++;

      Logger.error(TAG, `V2 upload failed, error queued for M1: ${String(error)}`);
      // Per SRS: "Since the data may not have been synced, the step may be terminated."
      // S2 continues acquiring to avoid data loss.
    }
  }

  /**
   * Clear all internal buffers.
   */
  private clearBuffers(): void {
    this.m1SensorBuffer = [];
    this.m1TargetAngleBuffer = [];
    this.m1ErrorBuffer = [];
    this.v2SensorBuffer = [];
    this.v2TargetAngleBuffer = [];
    this.v2ErrorBuffer = [];
    this.v2PendingErrors = [];
  }
}
