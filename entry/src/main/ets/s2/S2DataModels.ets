/**
 * S2 Data Models
 * All data types defined in the S2 interface specification.
 * Used by IF-S1-S2, IF-M1-S2, IF-S2-M1, and IF-S2-V2.
 */

/**
 * A single IMU sensor reading at one point in time.
 * (IF-S1-S2, Section 3.2.3)
 */
export class SensorSample {
  timestamp: number = 0;       // Unix timestamp in milliseconds
  deviceId: string = '';       // Unique sensor device identifier
  deviceName: string = '';     // Human-readable sensor name (e.g. "WTL1")
  accX: number = 0;           // Accelerometer X, in g
  accY: number = 0;           // Accelerometer Y, in g
  accZ: number = 0;           // Accelerometer Z, in g
  gyroX: number = 0;          // Gyroscope X, in deg/s
  gyroY: number = 0;          // Gyroscope Y, in deg/s
  gyroZ: number = 0;          // Gyroscope Z, in deg/s
  roll: number = 0;           // Orientation roll, in degrees
  pitch: number = 0;          // Orientation pitch, in degrees
  yaw: number = 0;            // Orientation yaw, in degrees
}

/**
 * Current state of the sensor connection.
 * (IF-S1-S2, Section 3.2.4)
 */
export class SensorStatus {
  connected: boolean = false;
  errorMessage: string | null = null;  // "sensor_disconnected" | "data_corruption" | "timeout" | null
}

/**
 * Session-level context, fixed for the entire session.
 * (IF-S2-M1, Section 3.4.3)
 */
export class SessionContext {
  sessionId: number = 0;                                    // Server-generated by V2
  userId: number = 0;                                       // References V2 users table
  sensorJointMapping: Record<string, string> = {};          // deviceId -> joint name
  payloadStatus: string = '';                                // Exercise/task type
  token: string = '';                                        // User auth token (SRS IUC-S2-01-01 step 1)
}

/**
 * Target angle computed by S2 core.
 * (IF-S2-M1, Section 3.4.4)
 */
export class TargetAngle {
  timestamp: number = 0;      // Unix timestamp in milliseconds
  angleID: string = '';        // Angle identifier (e.g. "knee", "hip")
  angle: number = 0;          // Computed angle, in degrees
}

/**
 * Error event detected during data acquisition.
 * (IF-S2-M1, Section 3.4.5)
 */
export class ErrorEvent {
  timestamp: number = 0;
  sensorId: string | null = null;
  errorType: string = '';      // "sensor_disconnected" | "validation_failure" | "timeout"
  message: string = '';
}

/**
 * Output data structure of S2.
 * Used by both IF-S2-M1 (function call) and IF-S2-V2 (HTTP).
 * (IF-S2-M1, Section 3.4.2)
 */
export class FormatData {
  sessionContext: SessionContext = new SessionContext();
  sensorData: SensorSample[] = [];
  targetAngles: TargetAngle[] = [];
  errors: ErrorEvent[] = [];
}

/**
 * Result of starting a session.
 * (IF-M1-S2, Section 3.3.3)
 */
export class StartResult {
  success: boolean = false;
  errorMessage: string | null = null;  // "session_already_active" | "sensor_not_connected" | null
}

/**
 * Summary returned when a session ends.
 * (IF-M1-S2, Section 3.3.4)
 */
export class SessionSummary {
  sessionId: number = 0;
  sampleCount: number = 0;
  errorCount: number = 0;
  startTime: string = '';      // ISO 8601
  endTime: string = '';        // ISO 8601
}
