/**
 * Session result page
 * UC-M1-02-04: Session ended, show score summary
 */
import promptAction from "@ohos.promptAction";
export class SessionResultPage extends ViewV2 {
    constructor(parent, params, __localStorage, elmtId = -1, paramsLambda, extraInfo) {
        super(parent, elmtId, extraInfo);
        this.sessionData = undefined;
        this.exerciseName = 'Exercise';
        this.isSaving = false;
        this.saveSuccess = false;
        this.finalizeConstruction();
    }
    resetStateVarsOnReuse(params) {
        this.sessionData = undefined;
        this.exerciseName = 'Exercise';
        this.isSaving = false;
        this.saveSuccess = false;
    }
    aboutToAppear() {
        const data = AppStorage.get('currentSessionData');
        if (data) {
            this.sessionData = data;
            this.exerciseName = this.getExerciseNameFromId(this.sessionData.exerciseId);
        }
    }
    getExerciseNameFromId(exerciseId) {
        if (exerciseId === 'ex_001')
            return 'Knee Flexion';
        if (exerciseId === 'ex_002')
            return 'Hip Extension';
        if (exerciseId === 'ex_003')
            return 'Ankle Rotation';
        if (exerciseId === 'ex_004')
            return 'Leg Raise';
        return 'Exercise';
    }
    formatDuration(milliseconds) {
        const totalSeconds = Math.floor(milliseconds / 1000);
        const minutes = Math.floor(totalSeconds / 60);
        const seconds = totalSeconds % 60;
        return `${minutes}:${seconds.toString().padStart(2, '0')}`;
    }
    getScoreGrade(score) {
        if (score >= 90) {
            const result = { grade: 'Excellent', color: Color.Green, emoji: 'ğŸŒŸ' };
            return result;
        }
        else if (score >= 80) {
            const result = { grade: 'Great', color: Color.Green, emoji: 'ğŸ‘' };
            return result;
        }
        else if (score >= 70) {
            const result = { grade: 'Good', color: Color.Orange, emoji: 'ğŸ’ª' };
            return result;
        }
        else if (score >= 60) {
            const result = { grade: 'Fair', color: Color.Orange, emoji: 'ğŸ¤”' };
            return result;
        }
        else {
            const result = { grade: 'Keep Trying', color: Color.Red, emoji: 'ğŸ“ˆ' };
            return result;
        }
    }
    calculateImprovement() {
        if (!this.sessionData?.scores || this.sessionData.scores.length < 2) {
            return 'N/A';
        }
        const firstScores = this.sessionData.scores.slice(0, 5);
        const lastScores = this.sessionData.scores.slice(-5);
        let firstSum = 0;
        for (let i = 0; i < firstScores.length; i++) {
            firstSum += firstScores[i];
        }
        const firstAvg = firstSum / firstScores.length;
        let lastSum = 0;
        for (let i = 0; i < lastScores.length; i++) {
            lastSum += lastScores[i];
        }
        const lastAvg = lastSum / lastScores.length;
        const improvement = lastAvg - firstAvg;
        const sign = improvement >= 0 ? '+' : '';
        return sign + improvement.toFixed(1);
    }
    syncToServer() {
        this.isSaving = true;
        setTimeout(() => {
            this.isSaving = false;
            this.saveSuccess = true;
            promptAction.showToast({
                message: 'Progress saved',
                duration: 2000
            });
        }, 1500);
    }
    onDone() {
        const storage = AppStorage.get('navPathStack');
        if (storage) {
            storage.clear();
        }
    }
    initialRender() {
        this.observeComponentCreation2((elmtId, isInitialRender) => {
            NavDestination.create(() => {
                this.observeComponentCreation2((elmtId, isInitialRender) => {
