                    else if (!this.isSensorConnected) {
                        this.ifElseBranchUpdateFunction(1, () => {
                            this.SensorWarningView.bind(this)();
                        });
                    }
                    else {
                        this.ifElseBranchUpdateFunction(2, () => {
                            this.ExerciseListView.bind(this)();
                        });
