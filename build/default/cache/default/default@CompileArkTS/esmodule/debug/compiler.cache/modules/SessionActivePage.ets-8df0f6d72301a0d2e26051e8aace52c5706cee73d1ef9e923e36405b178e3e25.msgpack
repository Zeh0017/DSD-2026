            Button.onClick(() => this.confirmEndSession());
        }, Button);
        Button.pop();
        Row.pop();
        Column.pop();
        Column.pop();
    }
    getAngleColor(current, target) {
        const deviation = Math.abs(current - target);
        if (deviation <= 10)
            return Color.Green;
        if (deviation <= 20)
            return Color.Orange;
        return Color.Red;
    }
    getScoreColor(score) {
        if (score >= 80)
            return Color.Green;
        if (score >= 60)
            return Color.Orange;
        return Color.Red;
    }
    getAlertColor(severity) {
        if (severity === 'high')
            return Color.Red;
        return Color.Orange;
    }
    rerender() {
        this.updateDirtyElements();
    }
}
